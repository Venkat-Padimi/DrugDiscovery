# Environment Variables Template
# Copy this file to .env and provide your credentials (if using external paid APIs).

# NCBI E-utilities Configuration
# Note: NCBI allows public access without an API key (up to 3 req/sec).
# Providing an email and tool name is required by NCBI guidelines.
NCBI_EMAIL=researcher@example.com
NCBI_TOOL=DrugDiscoveryAgent
NCBI_API_KEY=

# Open Targets Platform (Public GraphQL API - No key required)
OPEN_TARGETS_GRAPHQL_URL=https://api.platform.opentargets.org/api/v4/graphql

# ChEMBL REST API (Public - No key required)
CHEMBL_BASE_URL=https://www.ebi.ac.uk/chembl/api/data

# LLM Provider Configuration
# Options: "mock", "gemini", "openai", "anthropic", "ollama"
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Application Configuration
APP_ENV=development
API_PORT=8000
DASHBOARD_PORT=8501
DATA_DIR=data
SYNTHETIC_DATA_PATH=data/synthetic_experimental/sample_target_validation_assays.json
